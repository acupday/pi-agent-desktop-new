<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>English</string>
    <key>CFBundleDisplayName</key>
    <string>Pi Agent</string>
    <key>CFBundleExecutable</key>
    <string>node</string>
    <!--
      Must match the parent app identifier (com.abcwyc.pi-agent). A distinct
      helper bundle ID makes macOS Sequoia+ treat Node file access as a separate
      app (SystemPolicyAppData) and re-prompt "access data from other apps" on
      every launch even after Allow.
    -->
    <key>CFBundleIdentifier</key>
    <string>com.abcwyc.pi-agent</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Pi Agent Server</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>0.1.0</string>
    <key>LSBackgroundOnly</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <!--
      macOS Sequoia+ gates RFC1918 / link-local destinations behind Local
      Network privacy. Without this key the OS never prompts and Node's
      connect() to intranet model relays fails instantly with EHOSTUNREACH.
      Same CFBundleIdentifier as the parent so one grant covers both.
    -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Pi Agent connects to model APIs and tools on your local network when you configure an intranet Base URL.</string>
  </dict>
</plist>
